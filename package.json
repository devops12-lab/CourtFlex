{
  "name": "courtflex",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --parallel --filter @courtflex/player --filter @courtflex/portal --filter @courtflex/admin dev",
    "build": "pnpm --filter @courtflex/player build && pnpm --filter @courtflex/portal build:site && pnpm --filter @courtflex/admin build:site",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "dev:player": "pnpm --filter @courtflex/player dev",
    "dev:portal": "pnpm --filter @courtflex/portal dev",
    "dev:admin": "pnpm --filter @courtflex/admin dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1"
  },
  "type": "module"
}
